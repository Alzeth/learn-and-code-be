generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Course {
  id          String   @id  // "py01", "py02" etc
  title       String
  description String?
  lessons     CourseLesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lesson {
  id          String   @id  // "0111-1111-1111" etc
  title       String
  description String?
  icon        String?  @default("code")
  date        DateTime?
  theoryMd    String   // full markdown content from the .md files
  starterCode String   @default("")
  courses     CourseLesson[]
  submissions Submission[]
  progress    UserProgress[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Join table — handles ordering within a course and prev/next navigation
model CourseLesson {
  courseId    String
  lessonId    String
  position    Int
  prevLessonId String?
  nextLessonId String?

  course      Course  @relation(fields: [courseId], references: [id])
  lesson      Lesson  @relation(fields: [lessonId], references: [id])

  @@id([courseId, lessonId])
  @@index([courseId, position])
}

model Submission {
  id        Int      @id @default(autoincrement())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  code      String
  output    String?
  status    String   @default("pending")
  passed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  progress     UserProgress[]
}

model UserProgress {
  id          Int       @id @default(autoincrement())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}
