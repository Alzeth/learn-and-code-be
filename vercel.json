{
  "version": 2,
  "buildCommand": "npx prisma generate && npm run build && npx prisma migrate deploy",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
